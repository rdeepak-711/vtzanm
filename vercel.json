{
  "buildCommand": "npm --prefix frontend install --no-audit --no-fund && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "{backend,data}/**"
    }
  }
}
